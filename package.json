{
  "name": "whatsapp-server",
  "productName": "WhatsApp Server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node --experimental-sqlite --env-file-if-exists=.env server.js",
    "test": "node --experimental-sqlite test.js",
    "app": "electron .",
    "dist": "node scripts/make-icon.cjs && electron-builder --win",
    "dist:mac": "node scripts/make-icon.cjs && electron-builder --mac"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "link-preview-js": "^3.2.0",
    "pino": "^9.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.jayson.whatsapp-server",
    "productName": "WhatsApp Server",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "server.js",
      "ui.html",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "artifactName": "WhatsApp-Server-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  }
}